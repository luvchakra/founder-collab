NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the x-webhook-secret header on
# /api/webhooks/email-inbound. Generate a random value; configure the same value
# on your email provider's inbound-parse webhook.
EMAIL_INBOUND_WEBHOOK_SECRET=

# Real outbound sending. API key from resend.com; from-address must be on a
# domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Signing secret for Resend's delivery-status webhook (bounces/failures), checked
# against the svix-* headers on /api/webhooks/email-status. Copy it from the webhook's
# settings in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Canonical site URL for SEO metadata (Open Graph, canonical links, sitemap).
# Optional — falls back to the current Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=

# Shared secret checked against the "Authorization: Bearer <value>" header on
# /api/cron/drain-events (D-9). Generate a random value; configure the same value
# on whatever scheduler triggers the drain (Vercel Cron Jobs' own convention is this
# exact header).
CRON_SECRET=

# Comma-separated emails allowed onto /dashboard/admin (platform-admin demo data
# seed/delete tool). Matched case-insensitively against the signed-in user's email.
# Empty/unset = nobody has access, not "everybody".
PLATFORM_ADMIN_EMAILS=

# BYOK: encrypts provider API keys (packages/core/src/crypto/api-key.ts) before
# storing them in ai_provider_credentials. Must decode from base64 to exactly
# 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value makes every already-stored key undecryptable — treat it
# like a database credential, not an app config value.
API_KEY_ENCRYPTION_SECRET=

# Optional platform-owned Anthropic key (packages/module-discovery/src/lib/ai/router.ts).
# When set, any account that hasn't connected its own BYOK key automatically uses this
# credential instead of being blocked — its usage still counts against that account's
# normal free-tier caps (packages/module-discovery/src/lib/usage/limits.ts). Leave unset
# to require every account to bring its own key, as before.
PLATFORM_AI_API_KEY=

# CRM channel webhooks (docs/design/crm-module-design.md Part A, A2). App Secret from
# the Meta App dashboard, checked against each request's X-Hub-Signature-256 header
# (packages/module-crm/src/lib/webhooks/verify-meta-signature.ts) — both webhook
# families are Meta Graph API products and sign identically, but each has its own App
# in practice, hence two separate secrets/tokens rather than one shared pair.
CRM_META_APP_SECRET=
CRM_META_WEBHOOK_VERIFY_TOKEN=
CRM_WHATSAPP_APP_SECRET=
CRM_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
