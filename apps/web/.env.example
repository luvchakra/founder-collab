NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the x-webhook-secret header on
# /api/webhooks/email-inbound. Generate a random value; configure the same value
# on your email provider's inbound-parse webhook.
EMAIL_INBOUND_WEBHOOK_SECRET=

# Real outbound sending. API key from resend.com; from-address must be on a
# domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Signing secret for Resend's delivery-status webhook (bounces/failures), checked
# against the svix-* headers on /api/webhooks/email-status. Copy it from the webhook's
# settings in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Canonical site URL for SEO metadata (Open Graph, canonical links, sitemap).
# Optional — falls back to the current Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=

# Shared secret checked against the "Authorization: Bearer <value>" header on
# /api/cron/drain-events (D-9). Generate a random value; configure the same value
# on whatever scheduler triggers the drain (Vercel Cron Jobs' own convention is this
# exact header).
CRON_SECRET=

# BYOK: encrypts provider API keys (packages/core/src/crypto/api-key.ts) before
# storing them in ai_provider_credentials. Must decode from base64 to exactly
# 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value makes every already-stored key undecryptable — treat it
# like a database credential, not an app config value.
API_KEY_ENCRYPTION_SECRET=

# --- Payments: platform billing (businesses paying for module licenses) -------------
# Each provider is enabled only when ALL of its variables are set. Prices/plans are
# created in the provider dashboard and registered in core.billing_prices (see
# docs/compliance/payments.md). Use test-mode keys outside production.
#
# Stripe: secret key from Dashboard -> Developers -> API keys; webhook signing secret
# from the endpoint you point at https://<your-domain>/api/webhooks/stripe
# (events: customer.subscription.created/updated/deleted).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay: key pair from Dashboard -> Account & Settings -> API keys; webhook secret is
# whatever you enter when adding https://<your-domain>/api/webhooks/razorpay
# (events: subscription.*).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Privacy notice (/privacy) -- GDPR Art. 13 / DPDP s.5 ---------------------------
# Legal entity acting as controller / Data Fiduciary, and its contacts. Server-only.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
# DPDP s.8(10) grievance redressal -- falls back to PRIVACY_CONTACT_EMAIL.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=

# --- Security -------------------------------------------------------------------------
# Published at /.well-known/security.txt (RFC 9116) for vulnerability reports.
SECURITY_CONTACT_EMAIL=

# Scheduled jobs (all authenticated with CRON_SECRET above):
#   /api/cron/drain-events  every few minutes -- domain events (incl. privacy erasure)
#   /api/cron/maintenance   daily -- license grace expiry + data retention
