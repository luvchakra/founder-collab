{
  "name": "cofounderai-platform",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "node scripts/typecheck-all.mjs",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "build:help": "node scripts/build-help-content.mjs",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "build:screens": "node scripts/build-landing-screens.mjs",
    "build:progress": "node scripts/build-progress-tracker.mjs",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:module": "node scripts/test-module.mjs",
    "_comment:finance": "Finance lives in packages/module-gst (the module key stays 'gst'; only the display name is Finance). Further test:finance:* targets land with the phases that add their code, rather than being declared against tests that do not exist yet.",
    "test:finance": "npm run test -w packages/module-gst --",
    "test:finance:accounts": "npm run test -w packages/module-gst -- src/lib/accounting",
    "perf:rls": "node scripts/perf-check-tenant-license-rls.mjs",
    "lint:boundaries": "node scripts/lint-import-boundaries.mjs",
    "lint:migrations": "node scripts/lint-migration-schema.mjs",
    "lint:migration-grants": "node scripts/lint-migration-grants.mjs",
    "lint:gst-no-duplicate-masters": "node scripts/lint-gst-no-duplicate-masters.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
